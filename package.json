{
  "name": "duoplan",
  "version": "1.0.0",
  "private": true,
  "description": "DuoPlan: Cloudflare Worker, D1, Telegram Mini App и локальный Python-бот",
  "scripts": {
    "dev": "wrangler dev --local --port 8788",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "d1:migrate:local": "wrangler d1 migrations apply duoplan --local",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "devDependencies": {
    "wrangler": "4.160.0"
  }
}
