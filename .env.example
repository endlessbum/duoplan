# DuoPlan — пример конфигурации. Скопируйте файл в `.env` и заполните.
# Секреты в репозиторий не попадают: `.env` в .gitignore.

# Токен бота.
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Telegram username. Используется для формирования ссылок в Mini App.
BOT_USERNAME=duoplanbot

# Путь к SQLite. Относительный путь считается от корня проекта.
DB_PATH=data/duoplan.db

# IANA-часовой пояс: по нему считаются локальные дни, ритуал и серии.
TZ=Europe/Moscow

# Имя бота в текстах помощи.
BOT_NAME=DuoPlan

# Сколько секунд хранить незавершённый ввод (FSM). 0 — без ограничения.
FSM_TTL=604800

# Чат для пересылки необработанных ошибок бота (опционально).
# ADMIN_CHAT_ID=

# Cloudflare Worker (не для локального Python-бота):
# BOT_TOKEN и WEBHOOK_SECRET задаются в Settings → Variables and Secrets.
# SETUP_TOKEN опционален: если задан, используется для /api/setup вместо BOT_TOKEN.
# SETUP_TOKEN=
# APP_ORIGIN нужен воркеру для ссылок бота и setWebhook; в production он задан
# в wrangler.jsonc (vars), для локального wrangler dev укажите его в .dev.vars.
# APP_ORIGIN=https://duoplan.stacheight.workers.dev

# Гейт приватного бота: Telegram-ID владельца(-ов), через запятую.
# Без OWNER_IDS бот открыт для всех. После задания — доступ имеют только
# владелец и приглашённые через ссылку-приглашение (t.me/<бот>?start=КОД).
# OWNER_IDS=1234567890
#
# Worker: OWNER_IDS не лежит в репозитории. Для wrangler dev задайте его в
# .dev.vars; в production — в Variables and Secrets, там же, где переменные
# BOT_TOKEN/WEBHOOK_SECRET. wrangler.jsonc задаёт PRIVATE_BOT=true, поэтому
# пустой OWNER_IDS в production = 503 (PRIVATE_BOT_MISCONFIGURED), не публичный
# доступ. Локальный Python-бот читает OWNER_IDS из этого файла (.env).
