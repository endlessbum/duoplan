# DuoPlan — пример конфигурации. Скопируйте файл в `.env` и заполните.
# Секреты в репозиторий не попадают: `.env` в .gitignore.

# Токен бота из @BotFather. Обязателен.
BOT_TOKEN=

# Путь к SQLite. Относительный путь считается от корня проекта.
DB_PATH=data/duoplan.db

# IANA-часовой пояс: по нему считаются локальные дни, ритуал и серии.
TZ=Europe/Moscow

# Имя бота в текстах помощи.
BOT_NAME=DuoPlan

# Сколько секунд хранить незавершённый ввод (FSM). 0 — без ограничения.
FSM_TTL=604800

# Чат для пересылки необработанных ошибок бота (опционально).
# ADMIN_CHAT_ID=

# Cloudflare Worker (не для локального Python-бота):
# BOT_TOKEN и WEBHOOK_SECRET задаются в Settings → Variables and Secrets.
# SETUP_TOKEN опционален: если задан, используется для /api/setup вместо BOT_TOKEN.
# SETUP_TOKEN=
